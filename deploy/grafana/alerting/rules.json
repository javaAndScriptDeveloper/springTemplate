[
  {
    "uid": "app-service-down",
    "title": "ServiceDown",
    "ruleGroup": "app-baseline",
    "folderUID": "app",
    "orgID": 1,
    "condition": "C",
    "for": "3m",
    "noDataState": "Alerting",
    "execErrState": "Error",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "summary": "No app replica is being scraped. Check `make prod-ps` and `make prod-logs`."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "count(up{env=\"prod\"} == 1) < 1 or absent(up{env=\"prod\"})",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "app-high-error-rate",
    "title": "HighErrorRate",
    "ruleGroup": "app-baseline",
    "folderUID": "app",
    "orgID": 1,
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "summary": "More than 5 % of requests failed with 5xx over 10 minutes."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{env=\"prod\",status=~\"5..\"}[10m])) / sum(rate(http_server_requests_seconds_count{env=\"prod\"}[10m])) > 0.05) and sum(increase(http_server_requests_seconds_count{env=\"prod\"}[10m])) > 20",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "app-hikari-pending",
    "title": "DbConnectionsPending",
    "ruleGroup": "app-baseline",
    "folderUID": "app",
    "orgID": 1,
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "summary": "Requests are waiting for a database connection for 5 minutes: pool exhausted or database slow."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(hikaricp_connections_pending{env=\"prod\"}) > 0",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "app-heap-high",
    "title": "HeapHigh",
    "ruleGroup": "app-baseline",
    "folderUID": "app",
    "orgID": 1,
    "condition": "C",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "severity": "critical"
    },
    "annotations": {
      "summary": "Heap above 90 % of max for 10 minutes; raise APP_MEM_LIMIT or find the leak."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{env=\"prod\",area=\"heap\"}) / sum(jvm_memory_max_bytes{env=\"prod\",area=\"heap\"}) > 0.9",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  }
]