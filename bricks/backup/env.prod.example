# pg_dump every BACKUP_CRON, uploaded with rclone; nothing is kept on this disk. Needs rclone.conf in
# bricks/backup/rclone/ (bricks/backup/README.md).
# rclone remote and folder, e.g. gdrive:myservice or storagebox:backups/myservice.
RCLONE_REMOTE=
# Directory holding rclone.conf on this host (gitignored), relative to bricks/backup/ (compose resolves bind sources
# against the file that declares them). A directory, not the file: rclone saves refreshed tokens by rename, which
# fails on a single-file mount.
RCLONE_CONFIG_DIR=./rclone
# busybox cron schedule and the time zone it is read in.
BACKUP_CRON="0 */6 * * *"
BACKUP_TZ=UTC
# Dumps and pre-restore safety dumps older than this many days are pruned after a successful run.
BACKUP_RETENTION_DAYS=30
# `make prod-backup-status` fails beyond this age. The BackupStale alert's 12 h threshold lives in
# bricks/observability/grafana/alerting/rules.json: change both together.
BACKUP_MAX_AGE_HOURS=12
