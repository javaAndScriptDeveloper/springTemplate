# Local defaults. Committed, and used as-is when no .env exists (`make run` needs nothing from you).
# Copy to `.env` only to override something or to add the personal values in the last block. `.env` is gitignored.

# --- Application ---
APP_NAME=spring-template
SERVER_PORT=8080
# Label on every metric (dashboard "Environment" selector). Production sets prod.
APP_ENV=local

# --- Local database (compose.yml `db`) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Host port for the local Postgres (container port stays 5432). Change if something already listens on 5432.
DB_PORT=5432

# --- Local observability stack (`make observability-up`) ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Personal: production access from this machine (put these in .env, never commit them) ---
# SSH target for scripts/vps.sh and the vps-db skill: user@host or an alias from ~/.ssh/config.
#VPS_SSH=deploy@203.0.113.10
# Repository checkout on the VPS (default: ~/<repo name>).
#VPS_APP_DIR=~/spring-template
# Local end of the SSH tunnel to the production database.
#VPS_DB_LOCAL_PORT=15432

# --- Personal: ad-hoc dashboard push to Grafana Cloud (CI has the same values as repository secrets) ---
# Stack URL and a service-account token with dashboards:write (+ alert.provisioning:write for alerts).
#GRAFANA_URL=https://yourstack.grafana.net
#GRAFANA_API_TOKEN=
# Telegram alerts: set both to push alert rules; leave unset to skip alerting entirely.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
