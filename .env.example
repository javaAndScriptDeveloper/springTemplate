# Copy to `.env` and adjust. Loaded by docker compose (`make up`) and can be sourced for local runs.
# `.env` is gitignored; this example is committed.

# --- Application ---
APP_NAME=spring-template
SERVER_PORT=8080

# --- Database (shared by the `db` and `app` compose services) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Host port to expose PostgreSQL on (container port stays 5432).
DB_PORT=5432
